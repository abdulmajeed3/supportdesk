# =============================================================================
# SupportDesk — Environment Configuration Template
# Copy this file to .env and fill in the values for your environment.
# Never commit the .env file to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Frontend URL (used for CORS and links in responses)
FRONTEND_URL=http://localhost:4200

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=supportdesk
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=supportdesk
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Prisma database connection URL
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# Test database (used by integration tests — separate from dev database)
TEST_DB_USER=supportdesk_test
TEST_DB_PASSWORD=change_me_test
TEST_DB_NAME=supportdesk_test
TEST_DB_PORT=5433
TEST_DATABASE_URL=postgresql://${TEST_DB_USER}:${TEST_DB_PASSWORD}@localhost:${TEST_DB_PORT}/${TEST_DB_NAME}?schema=public

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_for_access_tokens
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret_for_refresh_tokens

# Token expiry durations (ms / zeit/ms format)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt / Argon2 rounds for password hashing (recommend 10-12 in dev, 12+ in prod)
PASSWORD_HASH_ROUNDS=12

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# Auth endpoint rate limit: max requests per window
RATE_LIMIT_AUTH_TTL=60000
RATE_LIMIT_AUTH_MAX=10

# Global rate limit
RATE_LIMIT_GLOBAL_TTL=60000
RATE_LIMIT_GLOBAL_MAX=100

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# LOG_LEVEL options: error, warn, log, debug, verbose
LOG_LEVEL=log
